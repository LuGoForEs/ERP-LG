# NOTA: para la DEMO de cátedra, la app arranca SIN configurar este archivo:
# settings.py y docker-compose.yml tienen valores demo por defecto (SECRET_KEY y
# POSTGRES_PASSWORD incluidos). Para un entorno REAL, definí valores propios acá
# (sobre todo SECRET_KEY larga/aleatoria y POSTGRES_PASSWORD); si están, se usan.

# ===== PostgreSQL =====
POSTGRES_DB=app1
POSTGRES_USER=app1_user
POSTGRES_PASSWORD=CAMBIAR_POR_UNA_CLAVE

# ===== Django =====
SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA
DEBUG=False

# ===== Email (demo: console — los links salen por `docker compose logs backend`) =====
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
FRONTEND_URL=https://app1.academia.ar

# ===== Cloudflare reCAPTCHA / Turnstile =====
# Secret key del backend (dejar vacío usa el modo de prueba). NO poner la real.
RECAPTCHA_SECRET_KEY=
# Site key pública del frontend (modo prueba). Se usa como build-arg.
VITE_RECAPTCHA_SITE_KEY=1x00000000000000000000AA
