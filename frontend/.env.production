# URL pública de la API (modelo de la guía). El SPA usa rutas relativas /api/v1
# proxeadas por nginx, así que esta variable queda como contrato/compatibilidad.
VITE_API_URL=https://api.app1.academia.ar

# Site key PÚBLICA de Cloudflare Turnstile en modo prueba (no es un secreto).
VITE_RECAPTCHA_SITE_KEY=1x00000000000000000000AA
